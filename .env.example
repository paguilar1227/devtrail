# Database
DATABASE_URL=postgresql://openbrain:openbrain@localhost:5432/openbrain

# API Auth
OPEN_BRAIN_API_KEY=your-api-key-here

# Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=your-connection-string
AZURE_STORAGE_CONTAINER=open-brain-files

# Google Gemini
GEMINI_API_KEY=your-gemini-key

# Anthropic
ANTHROPIC_API_KEY=your-anthropic-key

# Telegram
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_WEBHOOK_SECRET=your-webhook-secret

# Server
PORT=3000
NODE_ENV=development

# Review Mode: autonomous | hybrid | ask
REVIEW_MODE=hybrid

# Daily Digest: true | false
DAILY_DIGEST_ENABLED=true

# Telegram Chat ID (for notifications)
TELEGRAM_CHAT_ID=your-chat-id

# Timezone (IANA format)
TIMEZONE=America/Chicago

# Daily report time (24h format, in user's timezone)
DAILY_REPORT_TIME=09:00

# Consolidation schedule (Azure Functions CRON format)
# Every 30 min: 0 */30 * * * *
# Every hour:   0 0 * * * *
# Daily at 6AM: 0 0 6 * * *
CONSOLIDATION_SCHEDULE=0 */30 * * * *
