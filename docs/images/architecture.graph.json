{
  "schemaVersion": "0.3.1",
  "kind": "graph",
  "title": "DevTrail architecture",
  "summary": "DevTrail is one server that people and AI agents share. People use the web and iOS app; agents use the MCP server; scripts use the REST API. All three call the same services, so a todo, note, document or session handoff written by an agent is the same record a person reads. Postgres triggers record every change into a durable timeline, and everything saved is chunked, embedded and linked into an entity graph so hybrid search and cited answers can find it.",
  "lenses": [
    "architecture",
    "data-flow"
  ],
