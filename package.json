{
  "name": "open-brain-v2",
  "version": "2.0.0",
  "private": true,
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:up": "bash scripts/dev-up.sh",
    "dev:down": "bash scripts/dev-down.sh",
    "dev:reset": "bash scripts/dev-reset.sh",
    "compose:up": "docker compose up -d --wait",
    "compose:down": "docker compose down",
    "compose:reset": "docker compose down -v && docker compose up -d --wait",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "dev": "cd backend && npm run dev",
    "dev:full": "npm run compose:up && concurrently --names backend,frontend --prefix-colors cyan,magenta 'npm:dev:backend' 'npm:dev:frontend'",
    "seed:local": "cd backend && npx tsx ../scripts/seed-local.ts",
    "test": "cd backend && npm test",
    "test:watch": "cd backend && npm run test:watch",
    "test:e2e": "cd frontend && npm run test:e2e",
    "build:shared": "npm run build --workspace=@open-brain/shared",
    "build:backend": "cd backend && npm run build",
    "build:frontend": "cd frontend && npm install && npm run build",
    "build:all": "npm run build:shared && npm run build:backend && npm run build:frontend",
    "install:all": "npm install",
    "migrate": "cd backend && npm run migrate"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "lefthook": "^2.1.9",
    "wait-on": "^9.0.5"
  }
}
